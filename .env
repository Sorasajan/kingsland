# --- Database ---
# Postgres connection string (used by Prisma). Format:
#   postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://Touch:Touch@123@localhost:5432/kingsland

# --- SEO ---
# Fallback used by sitemap.xml, robots.txt, and page metadata if you
# haven't set a Site URL in /admin/seo yet. Set this to your real domain.
NEXT_PUBLIC_SITE_URL=https://kingsabroad.com

# --- Auth ---
# Secret used to sign admin session tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Used to encrypt sensitive settings saved via the admin dashboard
# (currently: the SMTP password in /admin/smtp) before they're stored
# in the database. Generate one the same way as JWT_SECRET, above —
# use a DIFFERENT value, don't reuse it. Falls back to JWT_SECRET if
# unset, which is fine for local dev but not recommended in production.
ENCRYPTION_KEY=replace-with-a-different-long-random-string

# Used by `npm run seed:admin` to create/reset the admin login.
# If ADMIN_PASSWORD is left unset, a random one is generated and printed once.
ADMIN_EMAIL=admin@kingsland.edu.np
ADMIN_NAME=Kingsland Admin
ADMIN_PASSWORD=Kingsland@123

# --- Email (optional) ---
# SMTP can now be configured entirely from /admin/smtp instead — these
# env vars are just a fallback for anything not set there (or for
# getting the very first "forgot password" email sent before you've
# logged in once to configure it via the dashboard).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Kingsland Abroad <no-reply@kingsland.edu.np>
CONTACT_RECEIVER_EMAIL=info@kingsland.edu.np
